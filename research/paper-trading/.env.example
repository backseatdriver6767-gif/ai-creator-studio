# Copy to .env and fill in as needed. EVERYTHING HERE IS OPTIONAL.
# The harness runs with zero env vars; these just enable extras.

# LLM agents (otherwise they stub)
ANTHROPIC_API_KEY=

# Notifications (otherwise stdout only)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Optional 3rd data source (free tier available)
ALPHA_VANTAGE_KEY=

# Shadow trading watchlist (comma-separated; also used by cron)
WATCHLIST=SPY,QQQ,IWM
